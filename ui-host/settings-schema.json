{
  "groups": [
    {
      "key": "getting_started",
      "name": "Getting Started",
      "groups": [
        {
          "key": "guide",
          "name": "Getting Started",
          "options": [
            {
              "key": "usage_guide",
              "name": "Usage Guide",
              "type": "guide",
              "default": ""
            }
          ]
        }
      ]
    },
    {
      "key": "basic",
      "name": "Basic Settings",
      "groups": [
        {
          "key": "model",
          "name": "Recognition Model",
          "options": [
            {
              "key": "model_name",
              "name": "Model",
              "type": "combobox",
              "default": "qwen3-asr-0.6b"
            },
            {
              "key": "download_0.6b",
              "name": "Qwen3-ASR-0.6B",
              "type": "modeldownload",
              "default": ""
            },
            {
              "key": "download_1.7b",
              "name": "Qwen3-ASR-1.7B",
              "type": "modeldownload",
              "default": ""
            },
            {
              "key": "mirror",
              "name": "Download Mirror",
              "type": "combobox",
              "default": "hf-mirror"
            }
          ]
        },
        {
          "key": "recognition",
          "name": "Recognition Options",
          "options": [
            {
              "key": "language",
              "name": "Recognition Language",
              "type": "combobox",
              "default": "English"
            },
            {
              "key": "stream_transcription",
              "text": "Enable streaming transcription",
              "type": "checkbox",
              "default": true
            }
          ]
        },
        {
          "key": "polish",
          "name": "Polish Model",
          "options": [
            {
              "key": "enabled",
              "text": "Refine recognition results with a local language model before committing (removes filler words and self-corrections, adds punctuation)",
              "type": "checkbox",
              "default": false
            },
            {
              "key": "model_name",
              "name": "Model",
              "type": "combobox",
              "default": "qwen3-0.6b"
            },
            {
              "key": "download_polish_0.6b",
              "name": "Qwen3-0.6B",
              "type": "modeldownload",
              "default": ""
            },
            {
              "key": "download_polish_1.7b",
              "name": "Qwen3-1.7B",
              "type": "modeldownload",
              "default": ""
            }
          ]
        },
        {
          "key": "recording",
          "name": "Recording",
          "options": [
            {
              "key": "source",
              "name": "Microphone",
              "type": "combobox",
              "default": ""
            },
            {
              "key": "min_record_seconds",
              "name": "Minimum recording time (s)",
              "type": "lineedit",
              "default": "0.25"
            },
            {
              "key": "rate",
              "name": "Sample rate (Hz)",
              "type": "combobox",
              "default": 16000
            },
            {
              "key": "channels",
              "name": "Channels",
              "type": "combobox",
              "default": 1
            },
            {
              "key": "format",
              "name": "Sample format",
              "type": "combobox",
              "default": "s16"
            }
          ]
        },
        {
          "key": "interaction",
          "name": "Interaction",
          "options": [
            {
              "key": "long_press_to_talk",
              "text": "Press and hold the left mouse button in a text field to talk",
              "type": "checkbox",
              "default": true
            },
            {
              "key": "focus_hint",
              "text": "Show a voice hint when a text field gains focus",
              "type": "checkbox",
              "default": true
            }
          ]
        }
      ]
    },
    {
      "key": "advanced",
      "name": "Advanced Settings",
      "groups": [
        {
          "key": "runtime",
          "name": "Runtime",
          "options": [
            {
              "key": "asr_timeout_seconds",
              "name": "Recognition timeout (s)",
              "type": "spinbutton",
              "default": 120,
              "min": 10,
              "max": 3600,
              "step": 10
            }
          ]
        },
        {
          "key": "fcitx",
          "name": "Fcitx",
          "options": [
            {
              "key": "fcitx_commit",
              "text": "Commit text through Fcitx",
              "type": "checkbox",
              "default": true
            }
          ]
        },
        {
          "key": "storage",
          "name": "Storage",
          "options": [
            {
              "key": "recordings_dir",
              "name": "Recordings directory",
              "type": "lineedit",
              "default": "$HOME/.local/share/echoflow/recordings"
            },
            {
              "key": "save_live_debug_audio",
              "text": "Save streaming debug recordings",
              "type": "checkbox",
              "default": false
            }
          ]
        }
      ]
    }
  ]
}
